# Mockshop UI route fix for pinned Onyx f858083d6cbe37c4146834d379e39511260a9879.
# /admin/groups2 has native list/create/detail pages, but the /admin/groups
# prefix match rewrites them to nonexistent /ee/admin/groups2 pages (HTTP404).
# Bound only the Groups EE matcher to its path segment; retain other EE matching,
# authentication, request headers, enterprise rewrites and license layout gates.
--- a/src/proxy.ts
+++ b/src/proxy.ts
@@ -149,7 +149,13 @@
   // Enterprise Edition: Rewrite EE-specific routes to /ee prefix. The /ee
   // layout turns away a deployment whose license does not cover them.
-  if (EE_ROUTES.some((route) => pathname.startsWith(route))) {
+  if (
+    EE_ROUTES.some((route) =>
+      route === "/admin/groups"
+        ? pathname === route || pathname.startsWith(`${route}/`)
+        : pathname.startsWith(route)
+    )
+  ) {
     const newUrl = new URL(`/ee${pathname}`, request.url);
     return withSecurityHeaders(
       NextResponse.rewrite(newUrl, { request: { headers: requestHeaders } })
     );
