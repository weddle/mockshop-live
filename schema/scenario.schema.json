{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/weddle/mockshop-live/schema/scenario.schema.json",
  "title": "Mockshop scenario",
  "description": "A scenario YAML file: plugins/<plugin>/scenarios/<name>.yaml. Derived from core/runner.mjs, core/clip.mjs, core/cli.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "name": { "type": "string", "description": "Output folder / clip name. Default: the file name without .yaml." },
    "title": { "type": "string", "description": "Informational label (not read by the runner)." },
    "viewport": { "$ref": "#/$defs/point", "description": "[width, height]. Default: manifest runner.viewport, else [1440, 900]. clip.viewport wins in clip mode." },
    "scale": { "type": "number", "minimum": 0.5, "maximum": 4, "description": "deviceScaleFactor. Default 1." },
    "theme": { "enum": ["light", "dark"], "description": "prefers-color-scheme. Default light." },
    "locale": { "type": "string", "description": "Language for this scenario. Precedence: CLI --locale, scenario locale, manifest runner.locale, a selector cookie in cookies, then manifest localization.default (else en-US). Must be in localization.locales when the plugin lists them." },
    "timezone": { "type": "string", "description": "IANA zone. Default: manifest runner.timezone, else America/New_York." },
    "cookies": { "type": "array", "items": { "type": "object", "required": ["name", "value"], "properties": { "name": { "type": "string" }, "value": { "type": "string" }, "domain": { "type": "string" }, "path": { "type": "string" } }, "additionalProperties": true }, "description": "Extra cookies added after the manifest's runner.cookies." },
    "overlays": { "type": "array", "items": { "type": "string" }, "description": "Extra fixture layer dirs under the plugin's fixtures/ (e.g. demo-empty-sidebar)." },
    "demo_anchor": { "type": ["string", "number"], "description": "Fixed demo 'now' (ISO 8601 with offset). Default: manifest runner.demo_anchor, else the real start time." },
    "continue_on_error": { "type": "boolean", "description": "Keep running after a failed step. Default false." },
    "strict": { "type": "boolean", "description": "Fail on any problem (console errors, HTTP>=400, unmocked requests), not just failed steps. Default: manifest runner.strict, else false." },
    "known_errors": { "$ref": "#/$defs/knownErrors" },
    "requires": { "type": ["string", "array"], "items": { "type": "string" }, "description": "Edition name(s) the built runtime must have; otherwise shot/clip skip this scenario." },
    "clip": { "$ref": "#/$defs/clip" },
    "cursor": { "$ref": "#/$defs/cursor", "description": "Scenario-level cursor defaults (docs/cursor.md)." },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "knownErrors": { "type": "array", "description": "Strict-mode allowlist: runner problems matching an entry are reported as known (with the reason) and do not fail the run. Failed steps are never allowlisted. Added to manifest runner.known_errors.", "items": { "type": "object", "additionalProperties": false, "required": ["match", "reason"], "properties": { "match": { "type": "string", "minLength": 1, "description": "Substring of the problem line, or /regex/flags." }, "reason": { "type": "string", "minLength": 1, "description": "Why this is expected (upstream race, declared placeholder, ...). Reviewed by the plugin owner." } } } },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "cursorStyle": { "type": "string", "enum": ["signature_arc", "spring_settle", "magnetic", "comet_swoop", "adaptive", "classic", "straight", "arc", "bow", "custom"] },
    "cursor": {
      "type": ["object", "boolean", "string"],
      "description": "Cursor options (docs/cursor.md): a known style name, true/false, or an object with motion/look options and optional shot still keys.",
      "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/cursorStyle" }, { "type": "object" }],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "screenshots": { "type": "boolean" },
        "style": { "$ref": "#/$defs/cursorStyle" },
        "timing": { "enum": ["native", "fitts", "fixed", "distance"] },
        "ms": { "type": ["number", "null"] },
        "speed": { "type": "number" },
        "ease": { "$ref": "#/$defs/cursorEase" },
        "path": { "enum": ["straight", "arc", "bow", null] },
        "settle": { "enum": ["none", "follow_through", "spring", null] },
        "heading": { "enum": ["tangent", "fixed", null] },
        "seed": { "type": ["string", "null"] },
        "reduced_motion": { "type": "boolean" },
        "arc_size": { "type": ["number", "null"] },
        "arc_flow": { "type": ["number", "null"] },
        "start_handle": { "type": ["number", "null"] },
        "end_handle": { "type": ["number", "null"] },
        "bow": { "type": ["number", "null"] },
        "overshoot": { "type": ["number", "null"] },
        "overshoot_px": { "type": ["number", "null"] },
        "cycles": { "type": ["number", "null"] },
        "decay": { "type": ["number", "null"] },
        "spring": { "type": ["number", "null"] },
        "peak_speed": { "type": ["number", "null"] },
        "min_start_speed": { "type": ["number", "null"] },
        "min_end_speed": { "type": ["number", "null"] },
        "turn_radius": { "type": ["number", "null"] },
        "base_ms": { "type": ["number", "null"] },
        "ms_per_px": { "type": ["number", "null"] },
        "min_ms": { "type": ["number", "null"] },
        "max_ms": { "type": ["number", "null"] },
        "effects": { "$ref": "#/$defs/cursorEffects" },
        "trail": { "$ref": "#/$defs/cursorTrail" },
        "glow": { "type": "number" },
        "pre_click_ms": { "type": ["number", "null"] },
        "look": { "$ref": "#/$defs/cursorLook" },
        "at": { "oneOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/locator" }] },
        "ripple": { "$ref": "#/$defs/cursorPulse" },
        "squish": { "$ref": "#/$defs/cursorPulse" },
        "magnet": { "oneOf": [{ "type": "boolean" }, { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }] }
      }
    },
    "cursorEase": {
      "oneOf": [
        { "enum": ["linear", "min_jerk", "smootherstep", "in_out_cubic", "in_out_sine", "out_cubic", null] },
        { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        { "type": "string", "pattern": "^cubic-bezier\\(\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?\\s*,\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?\\s*,\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?\\s*,\\s*[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?\\s*\\)$" }
      ]
    },
    "cursorEffects": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "trail": { "type": ["boolean", "null"] },
        "glow": { "type": ["boolean", "null"] },
        "magnet": { "type": ["boolean", "null"] },
        "ripple": { "type": ["boolean", "null"] },
        "squish": { "type": ["boolean", "null"] }
      }
    },
    "cursorTrail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secs": { "type": "number" },
        "fade_len": { "type": "number" },
        "steps": { "type": "number" },
        "tail_width": { "type": "number" },
        "head_width": { "type": "number" },
        "alpha": { "type": "number" }
      }
    },
    "cursorLook": {
      "type": "object",
      "additionalProperties": false,
      "description": "Built-in shape or custom SVG path (which overrides shape). Null fallback values retain the existing renderer defaults.",
      "properties": {
        "shape": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "viewbox": { "oneOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
        "hotspot": { "oneOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
        "size": { "type": ["number", "null"] },
        "fill": { "type": ["string", "null"] },
        "stroke": { "type": ["string", "null"] },
        "stroke_width": { "type": ["number", "null"] },
        "shadow": { "type": "boolean" },
        "shadow_color": { "type": ["string", "null"] },
        "shadow_blur": { "type": ["number", "null"] },
        "shadow_y": { "type": ["number", "null"] },
        "effect_color": { "type": "string" },
        "opacity": { "type": ["number", "null"] },
        "rotate": { "type": "boolean" },
        "halo": { "type": "boolean" },
        "float": { "type": "boolean" },
        "ripple_fill": { "type": "boolean" },
        "ripple_scale": { "type": ["number", "null"] }
      },
      "anyOf": [
        { "properties": { "shape": { "enum": ["arrow", "pointer", "dot", "ring"] } } },
        { "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } }
      ]
    },
    "cursorPulse": { "oneOf": [{ "type": "boolean" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "description": "Clip-mode pacing (all optional). Defaults from core/clip.mjs clipDefaults().",
      "properties": {
        "viewport": { "$ref": "#/$defs/point" },
        "type_delay_ms": { "type": "number", "minimum": 0, "description": "Default 55; per keystroke when type_ms is null." },
        "type_ms": { "type": ["number", "null"], "description": "Default 2500; total time per `type` step; null = per-keystroke." },
        "nav_fade": { "type": "number", "minimum": 0, "description": "Default 450 ms crossfade between navigations; 0 = hard cut." },
        "fade_ms": { "type": "number", "minimum": 0, "description": "Default 450; crossfade for click steps with fade: true." },
        "after_type_ms": { "type": "number", "minimum": 0, "description": "Default 700." },
        "move_ms": { "type": "number", "minimum": 0, "description": "Default 700; cursor glide duration." },
        "pre_click_ms": { "type": "number", "minimum": 0, "description": "Default 220." },
        "after_click_ms": { "type": "number", "minimum": 0, "description": "Default 600." },
        "settle_cap_ms": { "type": "number", "minimum": 0, "description": "Default 300; caps `settle` waits in clips." },
        "idle_timeout_ms": { "type": "number", "minimum": 0, "description": "Default 1500." },
        "hold_ms": { "type": "number", "minimum": 0, "description": "Default 2200; how long a `shot` holds." },
        "end_hold_ms": { "type": "number", "minimum": 0, "description": "Default 2500." },
        "title": { "type": ["string", "object"], "properties": { "title": { "type": "string" }, "subtitle": { "type": "string" } }, "additionalProperties": true, "description": "Title card over the first page: a string or { title, subtitle }." },
        "title_ms": { "type": "number", "minimum": 0, "description": "Default 3200." },
        "cursor": { "$ref": "#/$defs/cursor", "description": "Default true: draw the cursor overlay." },
        "fps": { "type": "number", "minimum": 1, "maximum": 120, "description": "Default 30." },
        "crf": { "type": "number", "minimum": 0, "maximum": 51, "description": "Default 18." },
        "preset": { "type": "string", "description": "x264 preset. Default slow." }
      }
    },
    "locatorObject": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one base key; the runner checks them in this order: testid, role, placeholder, label, selector, text.",
      "properties": {
        "testid": { "type": "string" },
        "role": { "type": "string", "description": "ARIA role; optional name/exact." },
        "name": { "type": "string", "description": "Accessible name (with role)." },
        "exact": { "type": "boolean", "description": "Exact match for name (with role) or text." },
        "placeholder": { "type": "string" },
        "label": { "type": "string" },
        "selector": { "type": "string", "description": "CSS/Playwright selector; visibility is NOT filtered." },
        "text": { "type": "string" },
        "has_text": { "type": "string", "description": "Further filter by contained text." },
        "nth": { "type": "integer", "minimum": 0 },
        "last": { "type": "boolean" },
        "any_visibility": { "type": "boolean", "description": "Include hidden elements." },
        "value": { "type": "string", "description": "fill/type: text to enter." },
        "delay": { "type": "number", "description": "type, shot mode: ms per key (default 15)." },
        "clip_delay": { "type": "number", "description": "type, clip mode: ms per key." },
        "clip_ms": { "type": ["number", "null"], "description": "type, clip mode: total typing time; null = per-keystroke." },
        "fade": { "type": "boolean", "description": "click, clip mode: crossfade the state change." },
        "settle": { "type": "number", "description": "click+fade, clip mode: settle ms (default 500)." },
        "state": { "enum": ["attached", "detached", "visible", "hidden"], "description": "wait: target state (default visible)." },
        "cursor": { "$ref": "#/$defs/cursor", "description": "Inline per-step cursor override; a step-level cursor modifier takes precedence." },
        "timeout": { "type": "number", "description": "wait/wait_gone: ms (default 20000)." }
      },
      "anyOf": [{ "required": ["testid"] }, { "required": ["role"] }, { "required": ["placeholder"] }, { "required": ["label"] }, { "required": ["selector"] }, { "required": ["text"] }]
    },
    "locator": { "oneOf": [{ "type": "string", "description": "Visible text (substring)." }, { "$ref": "#/$defs/locatorObject" }] },
    "moveObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": { "oneOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/locator" }] },
        "hold": { "type": "number", "minimum": 0, "description": "Clip mode ms to hold after moving." },
        "cursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "step": {
      "type": "object",
      "description": "One op key (the first key other than only/at/cursor is run) plus optional only/at/cursor.",
      "additionalProperties": false,
      "properties": {
        "only": { "enum": ["clip", "shot"], "description": "Run this step only in clip mode or only in screenshot mode." },
        "at": { "type": ["number", "string"], "description": "Clip mode: wait until this clip timestamp before running the step. Seconds (12.5), '12.5s', '1500ms' or 'mm:ss.s'." },
        "cursor": { "$ref": "#/$defs/cursor", "description": "Per-step cursor override for this step (docs/cursor.md)." },
        "goto": { "type": "string", "pattern": "^/", "description": "Path appended to the base URL, e.g. /app. Query strings are fine." },
        "click": { "$ref": "#/$defs/locator", "description": "Click at the element centre. Locator (+ fade, settle for clips)." },
        "hover": { "$ref": "#/$defs/locator" },
        "move": { "oneOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/locator" }, { "$ref": "#/$defs/moveObject" }], "description": "Glide the cursor to [x, y], a locator, or {to, hold?, cursor?} without clicking." },
        "pause": { "type": "number", "minimum": 0, "description": "ms; clip mode only (no-op for screenshots)." },
        "card": { "oneOf": [{ "type": "string" }, { "type": "object", "properties": { "title": { "type": "string" }, "subtitle": { "type": "string" }, "ms": { "type": "number" }, "keep": { "type": "boolean" }, "cursor": { "$ref": "#/$defs/cursor" } }, "additionalProperties": false }], "description": "Full-screen title card; clip mode only." },
        "fill": { "allOf": [{ "$ref": "#/$defs/locatorObject" }, { "required": ["value"] }], "description": "Locator + value; sets the value instantly." },
        "type": { "allOf": [{ "$ref": "#/$defs/locatorObject" }, { "required": ["value"] }], "description": "Locator + value; keystrokes (+ delay, clip_delay, clip_ms)." },
        "press": { "type": "string", "description": "Playwright key name, e.g. Enter, Control+K." },
        "wait": { "oneOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/locatorObject" }, { "type": "string" }], "description": "ms, or a locator (+ state: attached|detached|visible|hidden, timeout ms, default 20000)." },
        "wait_gone": { "$ref": "#/$defs/locator", "description": "Wait until the locator is hidden (+ timeout ms, default 20000)." },
        "settle": { "type": ["number", "null"], "description": "Wait for network idle and no skeletons, then ms (default 600)." },
        "eval": { "type": "string", "description": "JavaScript evaluated in the page." },
        "scroll": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/locatorObject" }], "description": "Pixels to scroll down (negative = up), or a locator to scroll into view." },
        "shot": { "oneOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/shotObject" }], "description": "Screenshot (shot mode) / hold beat (clip mode)." },
        "mark": { "$ref": "#/$defs/mark", "description": "Named timeline marker (no browser action). Written to the clip timeline." },
        "keyframe": { "$ref": "#/$defs/mark", "description": "Alias of mark." },
        "state": { "type": "object", "additionalProperties": false, "required": ["overlays"],
          "properties": { "overlays": { "type": "array", "items": { "type": "string" } }, "cursor": { "$ref": "#/$defs/cursor" } },
          "description": "Swap fixture overlays on the mock mid-run (keeps in-run state, demo clock, locale); [] = base. Follow with goto to reload." }
      },
      "oneOf": [
        { "required": ["goto"] }, { "required": ["click"] }, { "required": ["hover"] }, { "required": ["move"] }, { "required": ["pause"] },
        { "required": ["card"] }, { "required": ["fill"] }, { "required": ["type"] }, { "required": ["press"] }, { "required": ["wait"] },
        { "required": ["wait_gone"] }, { "required": ["settle"] }, { "required": ["eval"] }, { "required": ["scroll"] }, { "required": ["shot"] },
        { "required": ["mark"] }, { "required": ["keyframe"] }, { "required": ["state"] },
        { "required": ["cursor"], "properties": { "cursor": {}, "only": {}, "at": {} }, "additionalProperties": false, "description": "A step with cursor and optional only/at modifiers: change cursor settings from here on (no browser action)." }
      ]
    },
    "shotObject": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "File becomes NN-<name>.png." },
        "hover": { "$ref": "#/$defs/locator" },
        "delay": { "type": "number", "minimum": 0, "description": "Shot mode ms before capture. Default 300." },
        "hold": { "type": "number", "minimum": 0, "description": "Clip mode ms the beat holds. Default clip.hold_ms." },
        "full_page": { "type": "boolean" },
        "clip": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } }, "description": "Crop rectangle in CSS px." },
        "mouse": { "$ref": "#/$defs/point", "description": "Park the mouse here (default: bottom-right corner)." },
        "cursor": { "$ref": "#/$defs/cursor", "description": "Inline cursor override for this shot; a step-level cursor modifier takes precedence." }
      }
    },
    "mark": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "note": { "type": "string" }, "cursor": { "$ref": "#/$defs/cursor" } } }
      ]
    }
  }
}
