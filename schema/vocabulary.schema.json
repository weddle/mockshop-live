{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockshop.local/schema/vocabulary.schema.json",
  "title": "Mockshop plugin vocabulary",
  "description": "plugins/<name>/vocabulary.yaml: what an agent can demo with a plugin. Spec: docs/plugin-vocabulary.md. Snippet steps are checked against scenario.schema.json#/$defs/step by core/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin", "version", "summary", "surfaces"],
  "properties": {
    "plugin": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Must equal the plugin directory name." },
    "version": { "const": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "locales": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "default_locale": { "type": "string", "minLength": 1 },
    "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "moments": { "type": "array", "items": { "$ref": "#/$defs/moment" } },
    "not_supported": { "type": "array", "items": { "$ref": "#/$defs/unsupported" } },
    "snippets": { "type": "array", "items": { "$ref": "#/$defs/snippet" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "route": { "type": "string", "pattern": "^/" },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "routes", "status", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
        "status": { "enum": ["works", "partial", "placeholder", "needs-capture"] },
        "description": { "$ref": "#/$defs/text" },
        "notes": { "$ref": "#/$defs/text" },
        "edition": { "type": "string" },
        "group": { "type": "string", "description": "Optional nav grouping (e.g. the product's menu category)." }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "examples": { "type": "array", "items": { "type": "string" } },
        "surfaces": { "$ref": "#/$defs/ids" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "surface", "outcome"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "surface": { "$ref": "#/$defs/id" },
        "entities": { "$ref": "#/$defs/ids" },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "steps": { "$ref": "#/$defs/text" },
        "outcome": { "$ref": "#/$defs/text" },
        "persists": { "type": "boolean" },
        "status": { "enum": ["works", "partial", "not-supported"] },
        "scenario": { "type": "string" }
      }
    },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "surface", "shows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "surface": { "$ref": "#/$defs/id" },
        "shows": { "$ref": "#/$defs/text" },
        "scenario": { "type": "string" },
        "shot": { "type": "string" }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "why"],
      "properties": {
        "what": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "surface": { "$ref": "#/$defs/id" }
      }
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/id" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}
